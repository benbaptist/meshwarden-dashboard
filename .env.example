# meshwarden-dashboard configuration
# Copy to .env and adjust. Every value here is optional; defaults shown.
# Real environment variables take precedence over this file.

# --- Daemon connection (same variables as meshwarden-cli) ----------------------
# Defaults to 127.0.0.1; docker compose defaults it to host.docker.internal.
#MESHWARDEN_HOST=127.0.0.1
MESHWARDEN_PORT=50051
# TLS to the daemon: 1 | true | yes
MESHWARDEN_TLS=
# PEM contents (not paths), used when MESHWARDEN_TLS is enabled
MESHWARDEN_CA=
MESHWARDEN_CERT=
MESHWARDEN_KEY=

# --- HTTP server ------------------------------------------------------------------
MESHWARDEN_DASHBOARD_LISTEN=:8080
# Bearer token required for /api/ (WebSocket also accepts ?access_token=).
# Empty = no authentication; only expose the dashboard on trusted networks.
MESHWARDEN_DASHBOARD_TOKEN=
# Comma-separated cross-origin browser origins allowed to use the API and
# WebSocket, or * for any. Same-origin is always allowed.
MESHWARDEN_DASHBOARD_ALLOWED_ORIGINS=
# Serve the PWA from this directory instead of the build embedded in the binary
MESHWARDEN_DASHBOARD_WEB_DIR=
# Deadline for each daemon call made by the REST API
MESHWARDEN_DASHBOARD_RPC_TIMEOUT=30s
# debug | info | warn | error
MESHWARDEN_DASHBOARD_LOG_LEVEL=info

# --- docker compose only ------------------------------------------------------------
# Host port to publish the dashboard on
MESHWARDEN_DASHBOARD_PORT=8080
